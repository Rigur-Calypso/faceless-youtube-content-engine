# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.env
.venv
env/
venv/
ENV/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Generated voiceover & subtitles (re-created by engine)
audio/*.mp3
audio/*.srt
audio/*.txt
!audio/.gitkeep

# Generated intermediate clips (re-created during assembly)
clips/*.mp4
!clips/.gitkeep

# Generated final video & metadata (re-created during assembly)
output/*.mp4
output/*.json
!output/.gitkeep

# User visual assets (place your custom images here)
images/*.jpg
images/*.jpeg
images/*.png
images/*.webp
!images/.gitkeep
